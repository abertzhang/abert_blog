# PostgreSQL 连接配置（apps/api_go/.env.example）
# 复制为 .env 后按需修改；与 apps/api_express 共用同一套 Docker PostgreSQL
PGHOST=localhost
PGPORT=5433
PGDATABASE=blog
PGUSER=blog
PGPASSWORD=blog123456

# 监听端口（api_express=3001 / api_nest=3002 / api_go=3003，互不冲突）
PORT=3003

# JWT 令牌签名密钥（必须与 api_express 的 JWT_SECRET 保持一致，令牌才能跨后端互验）
JWT_SECRET=abert_blog_dev_secret_change_me
