# 国内镜像源
registry = https://registry.npmmirror.com

# node-linker=hoisted：扁平化 node_modules（不做 symlink 隔离）
#   原因 1：apps/phone_rn（Metro 打包器）与 One/Vite 方案对 symlink 布局兼容性差
#   原因 2：express/jade 这类 CJS 老包依赖扁平解析
#   注意：npm 不认识这个键，若有工具调用 npm 会打印一条 warning，属正常现象
node-linker=hoisted

# 关闭「运行前自动校验依赖并重新软链」：CI/沙箱里 pnpm 会尝试覆盖已存在的 store 软链，
# 被 FS broker 以 EEXIST 拒绝，导致 pnpm dev/build 在启动 Vite 前就失败。
# 关掉后直接执行脚本（vite/tsc 已就位），本地真实终端无影响。
verify-deps-before-run=false
